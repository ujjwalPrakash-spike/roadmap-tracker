def load_dataset():
    problems = []
    if not os.path.exists(DATASET_JS_PATH):
        return problems
    with open(DATASET_JS_PATH, "r") as f:
        content = f.read()
    pattern = re.compile(r'id:\s*"([^"]+)",\s*title:\s*"([^"]+)",\s*url:\s*"([^"]+)",\s*pattern:\s*"([^"]+)",\s*difficulty:\s*"([^"]+)",\s*track:\s*"([^"]+)",\s*order:\s*(\d+)')
    for m in pattern.finditer(content):
        problems.append({
            "id": m.group(1),
            "title": m.group(2),
            "url": m.group(3),
            "pattern": m.group(4),
            "difficulty": m.group(5),
            "track": m.group(6),
            "order": int(m.group(7))
        })
    return problems

def get_rank_and_progress(xp):
    if xp >= 1800:
        return "Level 5 · Systems Architect", 1800, 3000
    elif xp >= 800:
        return "Level 4 · Quant & DSA Specialist", 800, 1800
    elif xp >= 300:
        return "Level 3 · Interview Ready", 300, 800
    elif xp >= 100:
        return "Level 2 · Algorithms Builder", 100, 300
    return "Level 1 · Pattern Explorer", 0, 100

def calculate_xp(problems):
    xp = 0
    for p in problems:
        d = p.get("difficulty", "Medium")
        if d == "Hard":
            xp += 50
        elif d == "Medium":
            xp += 25
        else:
            xp += 10
    return xp

def calculate_streak(problems):
    if not problems:
        return 0
    days = sorted(set(p.get("logged_at", "").split("T")[0] for p in problems if p.get("logged_at")), reverse=True)
    if not days:
        return 0
    today_str = date.today().isoformat()
    yesterday_str = date.fromordinal(date.today().toordinal() - 1).isoformat()
    if days[0] != today_str and days[0] != yesterday_str:
        return 0
    streak = 1
    current_date = date.fromisoformat(days[0])
    for d in days[1:]:
        d_obj = date.fromisoformat(d)
        if (current_date.toordinal() - d_obj.toordinal()) == 1:
            streak += 1
            current_date = d_obj
        else:
            break
    return streak

def get_daily_deck(curated, data):
    solved_names = set(p.get("name", "").lower() for p in data.get("problems", []))
    unsolved = [p for p in curated if p["title"].lower() not in solved_names]
    failures = data.get("failures", [])
    
    deck = []
    if len(unsolved) > 0:
        deck.append(unsolved[0])
    if len(unsolved) > 1:
        deck.append(unsolved[1])
    if len(failures) > 0:
        f = failures[0]
        deck.append({
            "id": "rev-1",
            "title": f.get("problem_name", "Spaced Review"),
            "pattern": f.get("pattern", "Revision"),
            "difficulty": "Medium",
            "url": f"https://leetcode.com/problemset/all/?search={f.get('problem_name', '')}",
            "is_review": True,
            "reason": f.get("reason", "")
        })
    elif len(unsolved) > 2:
        deck.append(unsolved[2])
    return deck

