def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

def sync_cloud(data):
    cfg = load_config()
    url = cfg.get("supabase_url")
    key = cfg.get("supabase_key")
    if not url or not key:
        return
    import urllib.request, urllib.error
    try:
        req = urllib.request.Request(
            f"{url}/rest/v1/problems?select=*&order=logged_at.desc",
            headers={
                "apikey": key,
                "Authorization": f"Bearer {key}",
                "Content-Type": "application/json"
            }
        )
        with urllib.request.urlopen(req, timeout=3) as response:
            if response.status == 200:
                cloud_probs = json.loads(response.read().decode())
                existing_ids = set(p.get("id") for p in data.get("problems", []))
                for cp in cloud_probs:
                    if cp.get("id") not in existing_ids:
                        data["problems"].append(cp)
                        existing_ids.add(cp.get("id"))
                save_data(data)
    except Exception:
        pass

def push_problem_to_cloud(entry):
    cfg = load_config()
    url = cfg.get("supabase_url")
    key = cfg.get("supabase_key")
    if not url or not key:
        return
    import urllib.request, urllib.error
    try:
        payload = json.dumps({
            "name": entry["name"],
            "pattern": entry["pattern"],
            "difficulty": entry["difficulty"],
            "time_spent": entry.get("time_spent", 25),
            "logged_at": entry["logged_at"]
        }).encode('utf-8')
        req = urllib.request.Request(
            f"{url}/rest/v1/problems",
            data=payload,
            headers={
                "apikey": key,
                "Authorization": f"Bearer {key}",
                "Content-Type": "application/json",
                "Prefer": "return=minimal"
            }
        )
        with urllib.request.urlopen(req, timeout=3) as response:
            pass
    except Exception:
        pass


