def get_projects(data):
    if "projects" not in data or not data["projects"]:
        data["projects"] = DEFAULT_PROJECTS
        save_data(data)
    return data["projects"]

def cmd_projects(args):
    data = load_data()
    projects = get_projects(data)

    if args and args[0] in ["toggle", "check", "done"] and len(args) >= 3:
        try:
            p_num = int(args[1])
            s_idx = int(args[2]) - 1
            for p in projects:
                if p["project_num"] == p_num:
                    if 0 <= s_idx < len(p["stages"]):
                        p["stages"][s_idx]["done"] = not p["stages"][s_idx]["done"]
                        status = "COMPLETED" if p["stages"][s_idx]["done"] else "PENDING"
