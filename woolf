                        return
            print(f"{C_ROSE}Invalid project or milestone index.{C_RESET}")
        except ValueError:
            print(f"{C_ROSE}Usage: woolf projects toggle <project_num: 1-4> <milestone_num: 1-5>{C_RESET}")
        return

    print(f"\n{C_INDIGO}{C_BOLD}=== 4 SYSTEMS & QUANT CAPSTONE PROJECTS ==={C_RESET}")
    print(f"{C_MUTED}Kernel → Network → Persistent Storage → Hot Path HFT Engine{C_RESET}\n")

