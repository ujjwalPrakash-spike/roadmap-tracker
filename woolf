#!/usr/bin/env python3
"""
==============================================================================
Woolf Systems & Quant Engine — Terminal Study CLI (woolf)
==============================================================================
Usage:
  woolf                             Show daily status & 3-problem mission deck
  woolf solve <1|2|3>               1-click solve a mission slot
  woolf solve "Title" [Diff] [Cat]  Log any custom solved problem
  woolf fail <1|2|3> "Why missed"   Log a failure to spaced repetition bank
  woolf patterns                    Show ASCII mastery bars across all 18 patterns
  woolf search <query>              Search 327 curated NeetCode & Google problems
  woolf history                     View recent submissions
  woolf sync                        Sync with Supabase cloud backup
==============================================================================
"""

import sys, os, json, re, time
from datetime import datetime, date

CONFIG_DIR = os.path.expanduser("~/.config/woolf")
DATA_FILE = os.path.join(CONFIG_DIR, "data.json")
DATASET_JS_PATH = os.path.expanduser("~/roadmap-tracker/problems_dataset.js")

# ANSI Color formatting
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_DIM = "\033[2m"
C_GREEN = "\033[38;2;16;185;129m"
C_BLUE = "\033[38;2;56;189;248m"
C_INDIGO = "\033[38;2;99;102;241m"
C_VIOLET = "\033[38;2;129;140;248m"
C_AMBER = "\033[38;2;245;158;11m"
C_ROSE = "\033[38;2;244;63;94m"
C_MUTED = "\033[38;2;148;163;184m"

def init_storage():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(DATA_FILE):
        initial = {
            "problems": [],
            "failures": [],
            "streak": 0,
            "last_active": None,
            "config": {}
        }
        with open(DATA_FILE, "w") as f:
            json.dump(initial, f, indent=2)

def load_data():
    init_storage()
    try:
        with open(DATA_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return {"problems": [], "failures": [], "streak": 0, "last_active": None, "config": {}}

def save_data(data):
    init_storage()
    with open(DATA_FILE, "w") as f:
        json.dump(data, f, indent=2)

def load_dataset():
    problems = []
    if not os.path.exists(DATASET_JS_PATH):
        return problems
    with open(DATASET_JS_PATH, "r") as f:
        content = f.read()
    pattern = re.compile(r'id:\s*"([^"]+)",\s*title:\s*"([^"]+)",\s*url:\s*"([^"]+)",\s*pattern:\s*"([^"]+)",\s*difficulty:\s*"([^"]+)",\s*track:\s*"([^"]+)",\s*order:\s*(\d+)')
    for m in pattern.finditer(content):
        problems.append({
            "id": m.group(1),
            "title": m.group(2),
            "url": m.group(3),
            "pattern": m.group(4),
            "difficulty": m.group(5),
            "track": m.group(6),
            "order": int(m.group(7))
        })
    return problems

def get_rank(xp):
    if xp >= 1800:
        return "Level 5 · Systems Architect"
    elif xp >= 800:
        return "Level 4 · Quant & DSA Specialist"
    elif xp >= 300:
        return "Level 3 · Interview Ready"
    elif xp >= 100:
        return "Level 2 · Algorithms Builder"
    return "Level 1 · Pattern Explorer"

def calculate_xp(problems):
    xp = 0
    for p in problems:
        d = p.get("difficulty", "Medium")
        if d == "Hard":
            xp += 50
        elif d == "Medium":
            xp += 25
        else:
            xp += 10
    return xp

def calculate_streak(problems):
    if not problems:
        return 0
    days = sorted(set(p.get("logged_at", "").split("T")[0] for p in problems if p.get("logged_at")), reverse=True)
    if not days:
        return 0
    today_str = date.today().isoformat()
    yesterday_str = date.fromordinal(date.today().toordinal() - 1).isoformat()
    if days[0] != today_str and days[0] != yesterday_str:
        return 0
    streak = 1
    current_date = date.fromisoformat(days[0])
    for d in days[1:]:
        d_obj = date.fromisoformat(d)
        if (current_date.toordinal() - d_obj.toordinal()) == 1:
            streak += 1
            current_date = d_obj
        else:
            break
    return streak

def get_daily_deck(curated, data):
    solved_names = set(p.get("name", "").lower() for p in data.get("problems", []))
    unsolved = [p for p in curated if p["title"].lower() not in solved_names]
    failures = data.get("failures", [])
    
    deck = []
    if len(unsolved) > 0:
        deck.append(unsolved[0])
    if len(unsolved) > 1:
        deck.append(unsolved[1])
    if len(failures) > 0:
        f = failures[0]
        deck.append({
            "id": "rev-1",
            "title": f.get("problem_name", "Spaced Review"),
            "pattern": f.get("pattern", "Revision"),
            "difficulty": "Medium",
            "url": f"https://leetcode.com/problemset/all/?search={f.get('problem_name', '')}",
            "is_review": True,
            "reason": f.get("reason", "")
        })
    elif len(unsolved) > 2:
        deck.append(unsolved[2])
    return deck

def format_diff(diff):
    if diff == "Easy":
        return f"{C_GREEN}[EASY]{C_RESET}"
    elif diff == "Medium":
        return f"{C_AMBER}[MED]{C_RESET} "
    else:
        return f"{C_ROSE}[HARD]{C_RESET}"

def cmd_status():
    data = load_data()
    curated = load_dataset()
    deck = get_daily_deck(curated, data)
    
    today_str = date.today().isoformat()
    today_solved = [p for p in data.get("problems", []) if p.get("logged_at", "").startswith(today_str)]
    streak = calculate_streak(data.get("problems", []))
    xp = calculate_xp(data.get("problems", []))
    rank = get_rank(xp)
    total_solved = len(data.get("problems", []))

    print(f"\n{C_INDIGO}{C_BOLD}┌─────────────────────────────────────────────────────────────────────────┐{C_RESET}")
    print(f"{C_INDIGO}{C_BOLD}│  WOOLF SYSTEMS & QUANT ENGINE // STUDY TERMINAL                         │{C_RESET}")
    print(f"{C_INDIGO}{C_BOLD}├─────────────────────────────────────────────────────────────────────────┤{C_RESET}")
    print(f"│  {C_MUTED}Rank:{C_RESET}   {C_VIOLET}{rank:<33}{C_RESET} {C_MUTED}Streak:{C_RESET} {C_AMBER}{streak} Days 🔥{C_RESET}      │")
    print(f"│  {C_MUTED}XP:{C_RESET}     {C_BLUE}{xp} XP{C_RESET}       {C_MUTED}Today:{C_RESET} {C_GREEN}[{len(today_solved)}/3 Solved]{C_RESET}      {C_MUTED}Bank:{C_RESET}   {total_solved}/{len(curated)} Solved       │")
    print(f"{C_INDIGO}{C_BOLD}├─────────────────────────────────────────────────────────────────────────┤{C_RESET}")
    print(f"│  {C_BOLD}TODAY'S 3-PROBLEM MISSION:{C_RESET}                                             │")
    
    for idx, item in enumerate(deck, 1):
        is_rev = item.get("is_review", False)
        tag = f"{C_AMBER}SPACED REVIEW{C_RESET}" if is_rev else f"{C_VIOLET}CURRICULUM{C_RESET}"
        diff_badge = format_diff(item.get("difficulty", "Medium"))
        is_done = any(p.get("name", "").lower() == item["title"].lower() and p.get("logged_at", "").startswith(today_str) for p in data.get("problems", []))
        check = f"{C_GREEN}[✓ SOLVED]{C_RESET}" if is_done else f"{C_DIM}[PENDING]{C_RESET}"

        print(f"│                                                                         │")
        print(f"│  [{C_BOLD}{idx}{C_RESET}] {C_BOLD}{item['title']:<38}{C_RESET} {diff_badge} {check}         │")
        print(f"│      {C_DIM}Pattern:{C_RESET} {item['pattern']:<20} {C_DIM}Track:{C_RESET} {tag}               │")
        print(f"│      {C_BLUE}↳ {item['url']}{C_RESET}")
    
    print(f"{C_INDIGO}{C_BOLD}└─────────────────────────────────────────────────────────────────────────┘{C_RESET}")
    print(f"\n{C_DIM}Quick Solve:{C_RESET} {C_BOLD}woolf solve <1|2|3>{C_RESET}  |  {C_DIM}Log Custom:{C_RESET} {C_BOLD}woolf solve \"Title\"{C_RESET}  |  {C_DIM}Patterns:{C_RESET} {C_BOLD}woolf patterns{C_RESET}\n")

def cmd_solve(args):
    if not args:
        print(f"{C_ROSE}Usage:{C_RESET} woolf solve <1|2|3>  OR  woolf solve \"Problem Name\" [Easy|Medium|Hard] [Pattern] [Mins]")
        return
    data = load_data()
    curated = load_dataset()
    deck = get_daily_deck(curated, data)
    
    # Check if solving slot number
    if args[0] in ["1", "2", "3"]:
        slot_idx = int(args[0]) - 1
        if slot_idx >= len(deck):
            print(f"{C_ROSE}Invalid slot number {args[0]}.{C_RESET}")
            return
        target = deck[slot_idx]
        name = target["title"]
        pattern = target["pattern"]
        diff = target.get("difficulty", "Medium")
        mins = int(args[1]) if len(args) > 1 and args[1].isdigit() else 25
    else:
        name = args[0]
        diff = args[1] if len(args) > 1 else "Medium"
        pattern = args[2] if len(args) > 2 else "Arrays & Hashing"
        mins = int(args[3]) if len(args) > 3 and args[3].isdigit() else 25

    now_iso = datetime.utcnow().isoformat() + "Z"
    new_entry = {
        "id": "cli-" + str(int(time.time())),
        "name": name,
        "pattern": pattern,
        "difficulty": diff,
        "time_spent": mins,
        "logged_at": now_iso,
        "source": "cli"
    }
    data["problems"].insert(0, new_entry)
    
    # If this was in failures, remove it
    data["failures"] = [f for f in data.get("failures", []) if f.get("problem_name", "").lower() != name.lower()]
    
    save_data(data)
    xp_gain = 50 if diff == "Hard" else (25 if diff == "Medium" else 10)
    print(f"\n{C_GREEN}✓ Logged successfully!{C_RESET} {C_BOLD}{name}{C_RESET} ({diff}) · {pattern}")
    print(f"{C_BLUE}+{xp_gain} XP awarded!{C_RESET} Total XP: {C_BOLD}{calculate_xp(data['problems'])}{C_RESET}\n")

def cmd_fail(args):
    if not args:
        print(f"{C_ROSE}Usage:{C_RESET} woolf fail <1|2|3> \"Reason for missing\"  OR  woolf fail \"Problem Name\" \"Reason\"")
        return
    data = load_data()
    curated = load_dataset()
    deck = get_daily_deck(curated, data)

    if args[0] in ["1", "2", "3"]:
        slot_idx = int(args[0]) - 1
        if slot_idx >= len(deck):
            print(f"{C_ROSE}Invalid slot number.{C_RESET}")
            return
        name = deck[slot_idx]["title"]
        pattern = deck[slot_idx]["pattern"]
        reason = args[1] if len(args) > 1 else "Needs review"
    else:
        name = args[0]
        reason = args[1] if len(args) > 1 else "Needs review"
        pattern = "Algorithm Revision"

    new_fail = {
        "id": "fail-" + str(int(time.time())),
        "problem_name": name,
        "pattern": pattern,
        "reason": reason,
        "logged_at": datetime.utcnow().isoformat() + "Z"
    }
    data["failures"].insert(0, new_fail)
    save_data(data)
    print(f"\n{C_AMBER}⚠ Saved to Spaced Repetition Bank:{C_RESET} {C_BOLD}{name}{C_RESET}")
    print(f"{C_MUTED}Reason:{C_RESET} {reason}\n")

def cmd_patterns():
    data = load_data()
    curated = load_dataset()
    solved_names = set(p.get("name", "").lower() for p in data.get("problems", []))

    categories = [
        "Arrays & Hashing", "Two Pointers", "Sliding Window", "Stack",
        "Binary Search", "Linked List", "Trees", "Tries",
        "Heap / Priority Queue", "Backtracking", "Graphs", "Advanced Graphs",
        "1-D Dynamic Programming", "2-D Dynamic Programming", "Greedy",
        "Intervals", "Math & Geometry", "Bit Manipulation"
    ]

    print(f"\n{C_INDIGO}{C_BOLD}=== 18-PATTERN MASTERY BREAKDOWN ==={C_RESET}\n")
    for cat in categories:
        cat_probs = [p for p in curated if p["pattern"] == cat]
        total = len(cat_probs)
        solved = len([p for p in cat_probs if p["title"].lower() in solved_names])
        pct = int((solved / total) * 100) if total > 0 else 0
        
        # ASCII progress bar
        bar_len = 16
        filled = int((pct / 100) * bar_len)
        bar = f"{C_GREEN}{'█' * filled}{C_DIM}{'░' * (bar_len - filled)}{C_RESET}"
        
        print(f"  {cat:<24} [{bar}] {pct:>3}%  {C_MUTED}({solved}/{total}){C_RESET}")
    print()

def cmd_search(query):
    if not query:
        print(f"{C_ROSE}Usage:{C_RESET} woolf search <keyword>")
        return
    curated = load_dataset()
    data = load_data()
    solved_names = set(p.get("name", "").lower() for p in data.get("problems", []))

    matches = [p for p in curated if query.lower() in p["title"].lower() or query.lower() in p["pattern"].lower()]
    print(f"\n{C_BOLD}Found {len(matches)} matching problem(s):{C_RESET}\n")
    for p in matches[:15]:
        done = f"{C_GREEN}[SOLVED]{C_RESET}" if p["title"].lower() in solved_names else f"{C_DIM}[UNSOLVED]{C_RESET}"
        diff = format_diff(p["difficulty"])
        print(f"  {p['order']:>3}. {C_BOLD}{p['title']:<36}{C_RESET} {diff} {done}")
        print(f"       {C_MUTED}Pattern:{C_RESET} {p['pattern']:<20} {C_BLUE}↳ {p['url']}{C_RESET}")
    if len(matches) > 15:
        print(f"  {C_DIM}... and {len(matches) - 15} more{C_RESET}")
    print()

def cmd_history():
    data = load_data()
    problems = data.get("problems", [])
    print(f"\n{C_BOLD}Recent Solved History ({len(problems)} total):{C_RESET}\n")
    if not problems:
        print(f"  {C_DIM}No problems logged yet. Start solving with: woolf solve <1|2|3>{C_RESET}\n")
        return
    for p in problems[:10]:
        d_str = p.get("logged_at", "").split("T")[0]
        diff = format_diff(p.get("difficulty", "Medium"))
        print(f"  [{d_str}] {C_BOLD}{p.get('name', 'Unknown'):<32}{C_RESET} {diff}  {C_MUTED}{p.get('pattern', '')}{C_RESET}")
    print()

def main():
    args = sys.argv[1:]
    if not args or args[0] in ["status", "deck", "dashboard"]:
        cmd_status()
    elif args[0] in ["solve", "log", "done"]:
        cmd_solve(args[1:])
    elif args[0] in ["fail", "miss", "revisit"]:
        cmd_fail(args[1:])
    elif args[0] in ["patterns", "matrix", "radar"]:
        cmd_patterns()
    elif args[0] in ["search", "find"]:
        cmd_search(" ".join(args[1:]))
    elif args[0] in ["history", "logs", "recent"]:
        cmd_history()
    elif args[0] in ["help", "--help", "-h"]:
        print(__doc__)
    else:
        # Fallback to search or status
        cmd_search(" ".join(args))

if __name__ == "__main__":
    main()
