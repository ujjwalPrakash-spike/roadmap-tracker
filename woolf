    categories = [
        "Arrays & Hashing", "Two Pointers", "Sliding Window", "Stack",
        "Binary Search", "Linked List", "Trees", "Tries",
        "Heap / Priority Queue", "Backtracking", "Graphs", "Advanced Graphs",
        "1-D Dynamic Programming", "2-D Dynamic Programming", "Greedy",
        "Intervals", "Math & Geometry", "Bit Manipulation"
    ]

    print(f"\n{C['primary']}{C_BOLD}=== 18-PATTERN MASTERY BREAKDOWN ==={C_RESET}\n")
    for cat in categories:
        cat_probs = [p for p in curated if p["pattern"] == cat]
        total = len(cat_probs)
        solved = len([p for p in cat_probs if p["title"].lower() in solved_names])
        pct = int((solved / total) * 100) if total > 0 else 0
        
        bar_len = 16
        filled = int((pct / 100) * bar_len)
        bar = f"{C['green']}{'█' * filled}{C_DIM}{'░' * (bar_len - filled)}{C_RESET}"
        
        print(f"  {cat:<24} [{bar}] {pct:>3}%  {C['muted']}({solved}/{total}){C_RESET}")
    print()

def cmd_search(query):
    C = get_colors()
    if not query:
        print(f"{C['rose']}Usage:{C_RESET} woolf search <keyword>")
        return
    curated = load_dataset()
    data = load_data()
    solved_names = set(p.get("name", "").lower() for p in data.get("problems", []))

    matches = [p for p in curated if query.lower() in p["title"].lower() or query.lower() in p["pattern"].lower()]
    print(f"\n{C_BOLD}Found {len(matches)} matching problem(s):{C_RESET}\n")
    for p in matches[:15]:
        done = f"{C['green']}[SOLVED]{C_RESET}" if p["title"].lower() in solved_names else f"{C_DIM}[UNSOLVED]{C_RESET}"
        diff = format_diff(p["difficulty"], C)
        print(f"  {p['order']:>3}. {C_BOLD}{p['title']:<36}{C_RESET} {diff} {done}")
        print(f"       {C['muted']}Pattern:{C_RESET} {p['pattern']:<20} {C['secondary']}↳ {p['url']}{C_RESET}")
    if len(matches) > 15:
        print(f"  {C_DIM}... and {len(matches) - 15} more{C_RESET}")
    print()

def cmd_config(args):
    cfg = load_config()
    if not args:
        print(f"\n{C_BOLD}Supabase Cloud Configuration:{C_RESET}")
        print(f"  URL: {cfg.get('supabase_url', 'Not configured')}")
        print(f"  Key: {'Set (Hidden)' if cfg.get('supabase_key') else 'Not configured'}")
        print(f"\n{C_DIM}To set your Anon Key:{C_RESET} {C_BOLD}woolf config set-key <YOUR_SUPABASE_ANON_KEY>{C_RESET}\n")
        return
    if args[0] in ["set-key", "key"] and len(args) > 1:
        cfg["supabase_key"] = args[1].strip()
        save_config(cfg)
        print(f"\n{C_GREEN}✓ Saved Supabase Anon Key!{C_RESET} Testing sync...")
        data = load_data()
        sync_cloud(data)
        print(f"{C_BLUE}✓ Two-way Cloud Sync active with website.{C_RESET}\n")

def cmd_sync():
    data = load_data()
    print(f"\nSyncing with Supabase Cloud...")
    sync_cloud(data)
    print(f"{C_GREEN}✓ Sync completed!{C_RESET} {len(data.get('problems', []))} problem(s) in local ledger.\n")

def cmd_history():
    C = get_colors()
    data = load_data()
    problems = data.get("problems", [])
    print(f"\n{C_BOLD}Recent Solved History ({len(problems)} total):{C_RESET}\n")
    if not problems:
        print(f"  {C_DIM}No problems logged yet. Start solving with: woolf solve <1|2|3>{C_RESET}\n")
        return
    for p in problems[:10]:
        d_str = p.get("logged_at", "").split("T")[0]
        diff = format_diff(p.get("difficulty", "Medium"), C)
        print(f"  [{d_str}] {C_BOLD}{p.get('name', 'Unknown'):<32}{C_RESET} {diff}  {C['muted']}{p.get('pattern', '')}{C_RESET}")
    print()

def main():
    args = sys.argv[1:]
    if not args or args[0] in ["status", "deck", "dashboard"]:
        cmd_status()
    elif args[0] in ["solve", "log", "done"]:
        cmd_solve(args[1:])
    elif args[0] in ["fail", "miss", "revisit"]:
        cmd_fail(args[1:])
    elif args[0] in ["projects", "project", "proj"]:
        cmd_projects(args[1:])
    elif args[0] in ["patterns", "matrix", "radar"]:
        cmd_patterns()
    elif args[0] in ["search", "find"]:
        cmd_search(" ".join(args[1:]))
    elif args[0] in ["theme", "colors", "color"]:
        if len(args) > 1:
            set_theme(args[1])
        else:
            print("Current theme:", get_current_theme())
            print("Available themes: obsidian, emerald, sapphire, sunset")
    elif args[0] in ["sync", "pull", "push"]:
        cmd_sync()
    elif args[0] in ["config", "setup"]:
        cmd_config(args[1:])
    elif args[0] in ["history", "logs", "recent"]:

        cmd_history()
    elif args[0] in ["help", "--help", "-h"]:
        print(__doc__)
    else:
        cmd_search(" ".join(args))

if __name__ == "__main__":
    main()
